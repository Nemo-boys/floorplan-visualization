{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fi.scenario.v1",
  "title": "Simulation scenario (fi.scenario.v1)",
  "description": "Generated by tools/make-golden.mjs from BLOCK_TYPES in reference-src/engine.js. Cross-field and plan-aware rules (end after start, one block of each single type, staff coverage, arrivals after the last shift, rooms that exist) are in validateScenario.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "blocks"
  ],
  "properties": {
    "schema": {
      "const": "fi.scenario.v1"
    },
    "name": {
      "type": "string",
      "maxLength": 60
    },
    "preset": {
      "enum": [
        "normal",
        "flu",
        "short",
        "custom"
      ]
    },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "title": "Opening hours",
            "description": "When the doors open and close",
            "x-group": "day",
            "x-single": true,
            "x-required": true,
            "x-icon": "clock",
            "type": "object",
            "required": [
              "id",
              "type",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "hours"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "fields": {
                "type": "object",
                "required": [
                  "opens",
                  "closes"
                ],
                "additionalProperties": false,
                "properties": {
                  "opens": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "08:00",
                    "description": "Opens (24-hour HH:MM)",
                    "x-min": "06:00",
                    "x-max": "12:00"
                  },
                  "closes": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "18:00",
                    "description": "Closes (24-hour HH:MM)",
                    "x-min": "12:00",
                    "x-max": "22:00"
                  }
                }
              }
            }
          },
          {
            "title": "Run settings",
            "description": "How many days to simulate",
            "x-group": "day",
            "x-single": true,
            "x-required": true,
            "x-icon": "repeat",
            "type": "object",
            "required": [
              "id",
              "type",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "run"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "fields": {
                "type": "object",
                "required": [
                  "days",
                  "seed"
                ],
                "additionalProperties": false,
                "properties": {
                  "days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "default": 20,
                    "description": "Days to simulate. More days give a steadier range"
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99999,
                    "default": 42,
                    "description": "Random seed. Same seed, same results"
                  }
                }
              }
            }
          },
          {
            "title": "Staff shift",
            "description": "A group of staff and their hours",
            "x-group": "people",
            "x-single": false,
            "x-required": false,
            "x-icon": "person",
            "type": "object",
            "required": [
              "id",
              "type",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "shift"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "fields": {
                "type": "object",
                "required": [
                  "role",
                  "count",
                  "from",
                  "to"
                ],
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "provider",
                      "nurse",
                      "reception"
                    ],
                    "default": "nurse",
                    "description": "Role. provider: Provider; nurse: Nurse; reception: Receptionist"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 1,
                    "description": "How many"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "08:00",
                    "description": "From (24-hour HH:MM)"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "18:00",
                    "description": "To (24-hour HH:MM)"
                  }
                }
              }
            }
          },
          {
            "title": "Appointments",
            "description": "Booked visits, spread evenly",
            "x-group": "patients",
            "x-single": false,
            "x-required": false,
            "x-icon": "calendar",
            "type": "object",
            "required": [
              "id",
              "type",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "appointments"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "fields": {
                "type": "object",
                "required": [
                  "count",
                  "from",
                  "to",
                  "no_show"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 200,
                    "default": 50,
                    "description": "Booked visits"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "08:00",
                    "description": "First slot (24-hour HH:MM)"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "16:30",
                    "description": "Last slot (24-hour HH:MM)"
                  },
                  "no_show": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 50,
                    "default": 5,
                    "description": "No-shows (percent)"
                  }
                }
              }
            }
          },
          {
            "title": "Walk-ins",
            "description": "Patients without a booking",
            "x-group": "patients",
            "x-single": false,
            "x-required": false,
            "x-icon": "door",
            "type": "object",
            "required": [
              "id",
              "type",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "walkins"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "fields": {
                "type": "object",
                "required": [
                  "count",
                  "pattern",
                  "from",
                  "to"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 200,
                    "default": 10,
                    "description": "Walk-ins"
                  },
                  "pattern": {
                    "type": "string",
                    "enum": [
                      "steady",
                      "morning",
                      "lunch",
                      "afternoon"
                    ],
                    "default": "steady",
                    "description": "When they come. steady: Spread through the day; morning: Morning rush; lunch: Lunch peak; afternoon: After-school peak"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "08:00",
                    "description": "From (24-hour HH:MM)"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "17:00",
                    "description": "To (24-hour HH:MM)"
                  }
                }
              }
            }
          },
          {
            "title": "Visit type",
            "description": "A kind of visit and the provider’s time",
            "x-group": "visits",
            "x-single": false,
            "x-required": false,
            "x-icon": "stethoscope",
            "type": "object",
            "required": [
              "id",
              "type",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "visit_type"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "fields": {
                "type": "object",
                "required": [
                  "name",
                  "share",
                  "provider_min"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "default": "Standard visit",
                    "description": "Name"
                  },
                  "share": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 60,
                    "description": "Share of patients (percent)"
                  },
                  "provider_min": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 3,
                      "maximum": 120
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "default": [
                      15,
                      25
                    ],
                    "description": "Provider time (min) as [shortest, longest]"
                  }
                }
              }
            }
          },
          {
            "title": "Visit steps",
            "description": "Check-in, nurse intake and checkout",
            "x-group": "visits",
            "x-single": true,
            "x-required": true,
            "x-icon": "steps",
            "type": "object",
            "required": [
              "id",
              "type",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "steps"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "fields": {
                "type": "object",
                "required": [
                  "checkin",
                  "intake",
                  "checkout"
                ],
                "additionalProperties": false,
                "properties": {
                  "checkin": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 20
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "default": [
                      2,
                      4
                    ],
                    "description": "Check-in (min) as [shortest, longest]"
                  },
                  "intake": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 40
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "default": [
                      5,
                      9
                    ],
                    "description": "Nurse intake (min) as [shortest, longest]"
                  },
                  "checkout": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 20
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "default": [
                      1,
                      3
                    ],
                    "description": "Checkout (min) as [shortest, longest]"
                  }
                }
              }
            }
          },
          {
            "title": "Break",
            "description": "Staff step away for a while",
            "x-group": "timeline",
            "x-single": false,
            "x-required": false,
            "x-icon": "coffee",
            "type": "object",
            "required": [
              "id",
              "type",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "break"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "fields": {
                "type": "object",
                "required": [
                  "role",
                  "minutes",
                  "from",
                  "to",
                  "stagger"
                ],
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "provider",
                      "nurse",
                      "reception"
                    ],
                    "default": "nurse",
                    "description": "Who. provider: Provider; nurse: Nurse; reception: Receptionist"
                  },
                  "minutes": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 120,
                    "default": 30,
                    "description": "Length (min)"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "12:00",
                    "description": "Between (24-hour HH:MM)"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "14:00",
                    "description": "And (24-hour HH:MM)"
                  },
                  "stagger": {
                    "type": "boolean",
                    "default": true,
                    "description": "One at a time"
                  }
                }
              }
            }
          },
          {
            "title": "Staff out",
            "description": "Someone is away for part of the day",
            "x-group": "timeline",
            "x-single": false,
            "x-required": false,
            "x-icon": "person-off",
            "type": "object",
            "required": [
              "id",
              "type",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "out"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "fields": {
                "type": "object",
                "required": [
                  "role",
                  "count",
                  "from",
                  "to"
                ],
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "provider",
                      "nurse",
                      "reception"
                    ],
                    "default": "provider",
                    "description": "Who. provider: Provider; nurse: Nurse; reception: Receptionist"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 1,
                    "description": "How many"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "13:00",
                    "description": "From (24-hour HH:MM)"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "15:00",
                    "description": "To (24-hour HH:MM)"
                  }
                }
              }
            }
          },
          {
            "title": "Room closed",
            "description": "A room can’t be used for a while",
            "x-group": "timeline",
            "x-single": false,
            "x-required": false,
            "x-icon": "lock",
            "type": "object",
            "required": [
              "id",
              "type",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "closed"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "fields": {
                "type": "object",
                "required": [
                  "room",
                  "from",
                  "to"
                ],
                "additionalProperties": false,
                "properties": {
                  "room": {
                    "type": "string",
                    "default": "",
                    "description": "Room: the id of a room in the plan (exam_room)"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "09:00",
                    "description": "From (24-hour HH:MM)"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "11:00",
                    "description": "To (24-hour HH:MM)"
                  }
                }
              }
            }
          },
          {
            "title": "Group arrival",
            "description": "Several patients arrive at once",
            "x-group": "timeline",
            "x-single": false,
            "x-required": false,
            "x-icon": "group",
            "type": "object",
            "required": [
              "id",
              "type",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "group"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "fields": {
                "type": "object",
                "required": [
                  "count",
                  "at"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40,
                    "default": 6,
                    "description": "Patients"
                  },
                  "at": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "15:30",
                    "description": "At (24-hour HH:MM)"
                  }
                }
              }
            }
          },
          {
            "title": "When / Then",
            "description": "If something happens, do something",
            "x-group": "rules",
            "x-single": false,
            "x-required": false,
            "x-icon": "bolt",
            "type": "object",
            "required": [
              "id",
              "type",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "rule"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "fields": {
                "type": "object",
                "required": [
                  "metric",
                  "op",
                  "value",
                  "hold",
                  "from",
                  "to",
                  "action",
                  "role",
                  "count",
                  "delay",
                  "duration"
                ],
                "additionalProperties": false,
                "properties": {
                  "metric": {
                    "type": "string",
                    "enum": [
                      "waiting",
                      "longest",
                      "desk",
                      "free_rooms"
                    ],
                    "default": "waiting",
                    "description": "When. waiting: patients waiting in the lobby; longest: the longest current wait (min); desk: the line at reception; free_rooms: free exam rooms"
                  },
                  "op": {
                    "type": "string",
                    "enum": [
                      "gt",
                      "lt"
                    ],
                    "default": "gt",
                    "description": "is. gt: more than; lt: less than"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 200,
                    "default": 8,
                    "description": "Value"
                  },
                  "hold": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 180,
                    "default": 15,
                    "description": "For at least (min)"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "08:00",
                    "description": "Between (24-hour HH:MM)"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "default": "14:00",
                    "description": "And (24-hour HH:MM)"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "call_in",
                      "pause_walkins"
                    ],
                    "default": "call_in",
                    "description": "Then. call_in: call in extra staff; pause_walkins: stop taking walk-ins"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "provider",
                      "nurse",
                      "reception"
                    ],
                    "default": "nurse",
                    "description": "Who. provider: Provider; nurse: Nurse; reception: Receptionist"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5,
                    "default": 1,
                    "description": "How many"
                  },
                  "delay": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 120,
                    "default": 20,
                    "description": "Arrives after (min)"
                  },
                  "duration": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 600,
                    "default": 120,
                    "description": "For (min)"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
