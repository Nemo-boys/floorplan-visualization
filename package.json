{
  "name": "floorplan-intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "reference": "node tools/serve-reference.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && vitest run",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "capture:reference": "tsx tests/visual/capture.ts http://localhost:5174/reference.html tests/visual/reference",
    "test:visual": "tsx tests/visual/capture.ts http://localhost:5173/ tests/visual/output && tsx tests/visual/compare.ts",
    "golden:check": "node tools/make-golden.mjs --check"
  },
  "dependencies": {
    "three": "0.159.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.159.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
